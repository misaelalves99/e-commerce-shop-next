# -----------------------------------------------------------------------------
# Public application configuration
# -----------------------------------------------------------------------------

# Canonical public URL used for metadata and SEO.
# Local development may use http://localhost:3000.
# Set this to the deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Firebase public client configuration
# -----------------------------------------------------------------------------
# These values are intentionally public Firebase client identifiers.
# All six values are required for browser authentication to initialize.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Server-only configuration
# -----------------------------------------------------------------------------

# Secret accepted by POST /api/revalidate through the
# x-revalidate-secret request header.
REVALIDATE_SECRET=

# Firebase Admin credentials.
# Never expose these values through NEXT_PUBLIC_* variables.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
